# Set your own random password and token before starting.
POSTGRES_HOST=stintara-postgres
POSTGRES_PORT=5432
POSTGRES_DB=stintara
POSTGRES_USER=stintara
POSTGRES_PASSWORD=
APP_PORT=8080
TZ=Europe/Berlin

# Optional: if set, DATABASE_URL overrides the POSTGRES_* connection fields above.
DATABASE_URL=

BOOTSTRAP_DRIVER_NAME=Stintara Driver
BOOTSTRAP_DRIVER_SLUG=driver
BOOTSTRAP_AGENT_NAME=gaming-pc
BOOTSTRAP_AGENT_TOKEN=
